// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Fabrica {
  id               String    @id @default(cuid())
  nome             String
  taxaComissao     Float     @default(0)
  emailFaturamento String?
  produtos         Produto[]
  pedidos          Pedido[]
  historicoTabelas HistoricoTabela[]
  usuarios         Usuario[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Produto {
  id                 String       @id @default(cuid())
  codigo             String
  nome               String
  preco50a199        Decimal      @db.Decimal(10, 2)
  preco200a699       Decimal      @db.Decimal(10, 2)
  precoAtacado       Decimal      @db.Decimal(10, 2)
  precoAtacadoAVista Decimal      @db.Decimal(10, 2)
  precoRedes         Decimal      @db.Decimal(10, 2)
  imagem             String?
  categoria          String?
  unidade            String?      @default("CX")
  ativo              Boolean      @default(true)
  fabricaId          String
  fabrica            Fabrica      @relation(fields: [fabricaId], references: [id])
  itensPedido        ItemPedido[]
  itensPrePedido     ItemPrePedido[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Cliente {
  id                String           @id @default(cuid())
  razaoSocial       String
  nomeFantasia      String
  comprador         String?
  cnpj              String           @unique
  inscricaoEstadual String?
  email             String
  telefone          String
  celular           String
  endereco          String
  numero            String?
  bairro            String
  cidade            String
  estado            String
  cep               String
  status            String           @default("Ativo") // Ativo, Inativo, Bloqueado
  tabelaPreco       String?          @default("50a199")
  limiteCredito     Decimal?         @db.Decimal(10, 2)
  observacoes       String?
  pedidos           Pedido[]
  verbas            Verba[]
  historicoTabelas  HistoricoTabela[]
  visitas           Visita[]
  vendedorId        String?
  vendedor          Vendedor?        @relation(fields: [vendedorId], references: [id])
  prePedidos        PrePedido[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  contatoClientes   ContatoCliente[]
  metasCampanhas    MetaCampanha[]
}

model Pedido {
  id                String       @id @default(cuid())
  clienteId         String
  cliente           Cliente      @relation(fields: [clienteId], references: [id])
  fabricaId         String?
  fabrica           Fabrica?     @relation(fields: [fabricaId], references: [id])
  data              DateTime     @default(now())
  status            String       @default("Pendente") // Pendente, Processando, Concluido, Faturado, Cancelado
  dataFaturamento   DateTime?    // Setado automaticamente quando status muda para Faturado/Concluido
  tipo              String       @default("Venda") // Venda, Bonificacao
  valorTotal        Decimal      @db.Decimal(10, 2)
  tabelaPreco       String // 50a199, 200a699, atacado, avista, redes
  condicaoPagamento String
  observacoes       String?
  dataEntregaProgramada DateTime?   // Data agendada para entrega (apenas dia, sem controle de horário)
  notaFiscal        String?
  verbaId           String?
  verba             Verba?       @relation(fields: [verbaId], references: [id])
  vendedorId         String?
  vendedor           Vendedor?    @relation(fields: [vendedorId], references: [id])
  valorComissao      Decimal?     @db.Decimal(10, 2)
  nomeVendedorImport String?
  campanhaId         String?
  campanha                 Campanha?    @relation(fields: [campanhaId], references: [id])
  pagoAoVendedor           Boolean   @default(false)
  dataPagamentoAoVendedor  DateTime?
  campanha10OffAplicada    Boolean   @default(false)
  campanhaVinagreProdutos  String?   // Produtos vinculados na campanha (ex: "10.01.03.10,10.01.03.11")
  itens                    ItemPedido[]
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
}

model ItemPedido {
  id            String  @id @default(cuid())
  pedidoId      String
  pedido        Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto @relation(fields: [produtoId], references: [id])
  quantidade    Int
  precoUnitario Decimal @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)
}

model ContatoCliente {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  tipo      String // 'whatsapp' | 'email'
  mensagem  String
  status    String   @default("enviado") // enviado, entregue, lido, erro
  createdAt DateTime @default(now())
}

model Usuario {
  id        String   @id @default(cuid())
  nome      String
  username  String   @unique
  email     String? // Opcional
  senha     String // Hash bcrypt
  empresa   String?  @default("Minha Empresa")
  role      String   @default("vendedor") // admin, vendedor, industria
  fabricaId String?
  fabrica   Fabrica? @relation(fields: [fabricaId], references: [id])
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Verba {
  id          String   @id @default(cuid())
  clienteId   String
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  titulo      String
  valorTotal  Decimal  @db.Decimal(10, 2)
  status      String   @default("ATIVA") // ATIVA, ESGOTADA, CANCELADA
  observacoes  String?   @db.Text
  dataValidade DateTime?
  pedidos      Pedido[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Prospect {
  id                 String    @id @default(cuid())
  nomeEmpresa        String
  nomeContato        String
  telefone           String
  observacoes        String?
  dataUltimoContato  DateTime?
  dataProximoContato DateTime?
  status             String    @default("ATIVO")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Visita {
  id          String   @id @default(uuid())
  titulo      String   @default("Compromisso")
  clienteId   String?
  cliente     Cliente? @relation(fields: [clienteId], references: [id])
  dataVisita  DateTime
  status      String   @default("AGENDADA")
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HistoricoTabela {
  id             String   @id @default(cuid())
  clienteId      String
  cliente        Cliente  @relation(fields: [clienteId], references: [id])
  representadaId String
  representada   Fabrica  @relation(fields: [representadaId], references: [id])
  dataGeracao    DateTime @default(now())
}

model PerfilEmpresa {
  id                       String   @id @default("fixo")
  nomeEmpresa              String
  email                    String
  telefone                 String
  campanhaAlcool10OffAtiva Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

model Vendedor {
  id                 String   @id @default(cuid())
  nome               String
  telefone           String?
  email              String?  @unique
  codigoAcesso       String?  @unique
  senha              String?
  role               String   @default("VENDEDOR") // ADMIN, VENDEDOR
  percentualComissao Decimal  @default(0) @db.Decimal(5, 2)
  taxaRetencaoIR     Decimal  @default(0) @db.Decimal(5, 2)
  taxaRetencaoISSQN  Decimal  @default(0) @db.Decimal(5, 2)
  ativo              Boolean  @default(true)
  clientes           Cliente[]
  pedidos            Pedido[]
  prePedidos         PrePedido[]
  comissaoVigencias  ComissaoVigencia[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ComissaoVigencia {
  id         String   @id @default(cuid())
  vendedorId String
  vendedor   Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  percentual Float
  dataInicio DateTime
  createdAt  DateTime @default(now())

  @@index([vendedorId, dataInicio])
}

model Campanha {
  id               String    @id @default(cuid())
  slug             String    @unique
  nome             String
  status           String    @default("ATIVA") // ATIVA, ENCERRADA
  dataInicio       DateTime  @default(now())
  dataEncerramento DateTime?
  pedidos          Pedido[]
  metas            MetaCampanha[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model MetaCampanha {
  id                     String   @id @default(cuid())
  clienteId              String
  cliente                Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  campanhaId             String
  campanha               Campanha @relation(fields: [campanhaId], references: [id], onDelete: Cascade)
  metaCaixas             Int      @default(0)
  volumeAnteriorOverride Int?
  pedidoBaseId           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([clienteId, campanhaId])
}

model PrePedido {
  id         String          @id @default(cuid())
  data       DateTime        @default(now())
  clienteId  String
  cliente    Cliente         @relation(fields: [clienteId], references: [id])
  vendedorId String
  vendedor   Vendedor        @relation(fields: [vendedorId], references: [id])
  status         String          @default("PENDENTE") // PENDENTE, APROVADO, REJEITADO
  motivoRejeicao String?         @db.Text
  valorTotal     Decimal         @db.Decimal(10, 2)
  itens          ItemPrePedido[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ItemPrePedido {
  id            String    @id @default(cuid())
  prePedidoId   String
  prePedido     PrePedido @relation(fields: [prePedidoId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto   @relation(fields: [produtoId], references: [id])
  quantidade    Int
  precoUnitario Decimal   @db.Decimal(10, 2)
}
